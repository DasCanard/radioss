{
  "name": "radioss",
  "private": true,
  "version": "0.9.5",
  "description": "A modern, cross-platform internet radio player built with Electron, React, and TypeScript.",
  "author": "richy",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:update": "node scripts/dev.mjs --force-update-check",
    "web:dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc && electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "register-scheme": "file:stubs/register-scheme"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.4.2",
    "vitest": "^4.1.5"
  }
}
